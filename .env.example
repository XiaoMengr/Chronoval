# ================================================================
# Chronoval 环境配置（.env.example）
# ================================================================
# 绝大多数配置（管理员账号、站点信息、地图、存储方案）都已在【首次运行引导向导】里
# 分步填写，部署后打开网页即可完成，不需要在这里手动配置。
#
#   cp .env.example .env
#
# 本文件只需放【可选】的覆盖项/高级项，默认不填也能正常完成首次安装。

# ----------------------------------------------------------------
# 管理员账号（可选预填）
# ----------------------------------------------------------------
# 首次运行引导向导的"管理员"步骤会优先使用下面三个值作为默认值（向导里也可修改）。
# 不填也在网页里直接输入即可，无需在此强制配置：
# CFRAME_ADMIN_EMAIL=
# CFRAME_ADMIN_PASSWORD=

# ----------------------------------------------------------------
# 会话加密密钥（可选，默认自动生成）
# ----------------------------------------------------------------
# 未设置时，应用首次启动会自动生成随机密钥并持久化到 ./data/.session-password，
# 之后启动自动复用，无需手动执行 openssl。/data 对应 docker-compose 里的持久化卷。
# 只有需要"固定密钥"时才手动指定：
# NUXT_SESSION_PASSWORD=

# 分享页/OG 图签名密钥（可选；缺失时也能正常工作）
# NUXT_OG_IMAGE_SECRET=

# ---- 站点信息（可选，也可在引导向导/后台设置）----
# NUXT_PUBLIC_APP_TITLE=Chronoval
# NUXT_PUBLIC_APP_SLOGAN=
# NUXT_PUBLIC_APP_AUTHOR=
# NUXT_PUBLIC_APP_AVATAR_URL=
# 主题：light / dark / system
# NUXT_PUBLIC_COLOR_MODE_PREFERENCE=dark

# ---- 地图（可选，也可在引导向导/后台设置）----
# 仅当要在地图上浏览拍摄位置时需要；maplibre 免费，mapbox 需令牌
# NUXT_PUBLIC_MAP_PROVIDER=maplibre
# NUXT_PUBLIC_MAP_MAPLIBRE_STYLE=
# NUXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# NUXT_PUBLIC_MAP_MAPBOX_STYLE=
# 服务端反地理编码（Mapbox secret token）
# NUXT_MAPBOX_ACCESS_TOKEN=
# 官方服务不可用时（如大陆）可改用代理或自建 Nominatim
# NUXT_NOMINATIM_BASE_URL=

# ---- 存储（可选覆盖；默认本地文件系统已固化进镜像，可在向导/后台切换）----
# 用 S3 时才需要：
# NUXT_STORAGE_PROVIDER=s3
# NUXT_PROVIDER_S3_ENDPOINT=
# NUXT_PROVIDER_S3_BUCKET=
# NUXT_PROVIDER_S3_REGION=auto
# NUXT_PROVIDER_S3_ACCESS_KEY_ID=
# NUXT_PROVIDER_S3_SECRET_ACCESS_KEY=
# NUXT_PROVIDER_S3_PREFIX=photos/
# NUXT_PROVIDER_S3_CDN_URL=
# NUXT_PROVIDER_S3_FORCE_PATH_STYLE=false
# 用 OpenList 时才需要：
# NUXT_STORAGE_PROVIDER=openlist
# NUXT_PROVIDER_OPENLIST_BASE_URL=
# NUXT_PROVIDER_OPENLIST_ROOT_PATH=
# NUXT_PROVIDER_OPENLIST_TOKEN=
# NUXT_PROVIDER_OPENLIST_ENDPOINT_UPLOAD=/api/fs/put
# 本地存储根路径（只有想改默认目录时才设，镜像默认 /app/data/storage）：
# NUXT_PROVIDER_LOCAL_PATH=/app/data/storage
# NUXT_PROVIDER_LOCAL_BASE_URL=/storage
# NUXT_PROVIDER_LOCAL_PREFIX=photos/

# ---- 媒体库（可选覆盖；默认已指向镜像内 /app/storage/photos、/app/storage/videos）----
# LIBRARY_PHOTOS_PATH=/app/storage/photos
# LIBRARY_VIDEOS_PATH=/app/storage/videos
# 自动重扫间隔毫秒，默认 300000（5 分钟）
# LIBRARY_SCAN_INTERVAL_MS=300000

# ---- 登录方式（可选）----
# GitHub OAuth 登录
# NUXT_PUBLIC_OAUTH_GITHUB_ENABLED=false
# NUXT_OAUTH_GITHUB_CLIENT_ID=
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# ---- 统计（可选）----
# Google Analytics
# NUXT_PUBLIC_GTAG_ID=
# Matomo
# NUXT_PUBLIC_ANALYTICS_MATOMO_ENABLED=false
# NUXT_PUBLIC_ANALYTICS_MATOMO_URL=
# NUXT_PUBLIC_ANALYTICS_MATOMO_SITE_ID=

# ---- 上传（可选，默认合理）----
# 上传文件 MIME 白名单校验
# NUXT_UPLOAD_MIME_WHITELIST_ENABLED=true
# NUXT_UPLOAD_MIME_WHITELIST=image/jpeg,image/png,image/webp,image/gif,image/bmp,image/tiff,image/heic,image/heif,video/quicktime,video/mp4

# ---- 安全（默认关闭，生产/公网环境请勿开启）----
# 允许非 HTTPS 传输 cookie
# NUXT_ALLOW_INSECURE_COOKIE=false

# 重复文件检测已移至后台：设置 -> 系统